{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notes (tauri-cordis example)",
  "version": "0.1.0",
  "identifier": "dev.tauri-cordis.example.notes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notes (tauri-cordis example)",
        "width": 900,
        "height": 600,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' notes-plugin: http://notes-plugin.localhost; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* notes-plugin: http://notes-plugin.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
