{
  "name": "@tauri-cordis/review",
  "version": "0.2.0",
  "description": "Version-to-version plugin source and bundle diff analyzer for tauri-cordis markets",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "tauri",
    "cordis",
    "tauri-cordis",
    "plugin",
    "review",
    "diff",
    "supply-chain",
    "audit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TixXin/tauri-cordis.git",
    "directory": "packages/review"
  },
  "homepage": "https://github.com/TixXin/tauri-cordis",
  "bugs": {
    "url": "https://github.com/TixXin/tauri-cordis/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./cli": "./src/cli.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@tauri-cordis/manifest": "workspace:*"
  }
}
