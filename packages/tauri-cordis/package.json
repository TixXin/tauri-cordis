{
  "name": "tauri-cordis",
  "version": "0.1.0",
  "description": "Everything-is-a-plugin runtime base for Tauri + Node + React built on Cordis: host supervisor protocol, versioned services, managed side effects, and window slots",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TixXin/tauri-cordis.git",
    "directory": "packages/tauri-cordis"
  },
  "homepage": "https://github.com/TixXin/tauri-cordis",
  "bugs": {
    "url": "https://github.com/TixXin/tauri-cordis/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "vendor",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./host": {
      "types": "./src/host/index.d.mts",
      "default": "./src/host/index.mjs"
    },
    "./client": {
      "types": "./src/client/index.d.mts",
      "default": "./src/client/index.mjs"
    },
    "./client/slots": {
      "types": "./src/client/slots.d.mts",
      "default": "./src/client/slots.mjs"
    },
    "./client/window-services": {
      "types": "./src/client/window-services.d.mts",
      "default": "./src/client/window-services.mjs"
    },
    "./client/react": {
      "types": "./src/client/react.d.mts",
      "default": "./src/client/react.mjs"
    },
    "./protocol": {
      "types": "./src/protocol.d.mts",
      "default": "./src/protocol.mjs"
    },
    "./services": {
      "types": "./src/services.d.mts",
      "default": "./src/services.mjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.15"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.0",
    "@standard-schema/spec": "^1.1.0",
    "@tauri-cordis/manifest": "workspace:*",
    "chokidar": "^4.0.3",
    "cosmokit": "^1.8.1",
    "picomatch": "^4.0.3",
    "schemastery": "^3.18.0",
    "ws": "^8.23.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  }
}
